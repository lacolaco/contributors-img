{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["jasmine", "node"],
    "moduleResolution": "bundler",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "preserve",
    "lib": ["dom", "es2022"],
    "isolatedModules": true
  },
  "include": ["**/*.spec.ts", "**/*.test.ts", "**/*.d.ts"]
}
